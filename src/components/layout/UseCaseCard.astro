---
interface Props {
  id: string;
  title: string;
  description: string;
  icon: string;
  tags: string[];
}

const { id, title, description, icon, tags } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a
  href={`${base}use-cases/${id}/`}
  class="group block rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md hover:border-blue-300"
>
  <div class="text-3xl mb-3">{icon}</div>
  <h2 class="text-xl font-semibold mb-2 group-hover:text-blue-600 transition-colors">{title}</h2>
  <p class="text-sm text-gray-600 mb-4">{description}</p>
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="inline-block rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600">
        {tag}
      </span>
    ))}
  </div>
</a>
