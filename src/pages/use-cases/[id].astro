---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useCases } from '../../data/use-cases';
import { PlaygroundShell } from '../../components/playground/PlaygroundShell';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return useCases.map((uc) => ({
    params: { id: uc.id },
    props: uc,
  }));
};

const { id, title, description, icon } = Astro.props;
---

<BaseLayout title={`${title} — LPO Use Cases`} description={description}>
  <div class="mx-auto max-w-7xl px-4 py-8">
    <div class="mb-6">
      <a href={import.meta.env.BASE_URL} class="text-sm text-blue-600 hover:text-blue-800 transition-colors">
        &larr; Back to all use cases
      </a>
    </div>
    <div class="mb-8">
      <span class="text-3xl">{icon}</span>
      <h1 class="text-3xl font-bold mt-2">{title}</h1>
      <p class="text-gray-600 mt-2">{description}</p>
    </div>

    <PlaygroundShell useCaseId={id} client:load />

    <!-- How to use -->
    <div class="mt-8 rounded-xl border border-gray-200 bg-white p-6">
      <h3 class="text-lg font-semibold mb-4">How to Use</h3>
      <ol class="list-decimal list-inside space-y-2 text-sm text-gray-700">
        <li>Adjust the settings in the <strong>Settings</strong> panel to customize the component.</li>
        <li>Watch the <strong>Preview</strong> update in real-time as you make changes.</li>
        <li>Set the <strong>Match URL</strong> to the website where you want the component to appear.</li>
        <li>Click <strong>Copy Script</strong> to copy the generated TamperMonkey script.</li>
        <li>Open TamperMonkey in your browser and create a new script.</li>
        <li>Paste the copied script and save it.</li>
        <li>Visit the target website to see your personalization in action!</li>
      </ol>
    </div>
  </div>
</BaseLayout>
