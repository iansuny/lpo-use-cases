---
import DemoLayout from '../layouts/DemoLayout.astro';
import { DemoOverlay } from '../components/demo/DemoOverlay';

const base = import.meta.env.BASE_URL;
---

<DemoLayout title="Horizon Mastercard World — Horizon Bank">

<!-- ─── Navbar ─── -->
<nav style="background:#fff; border-bottom:1px solid #f3f4f6; position:sticky; top:0; z-index:100;">
  <div style="max-width:1120px; margin:0 auto; padding:0 24px; height:64px; display:flex; align-items:center; justify-content:space-between;">
    <!-- Logo -->
    <div style="display:flex; align-items:center; gap:10px;">
      <div style="width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg, #EB001B, #FF5F00); display:flex; align-items:center; justify-content:center;">
        <div style="width:18px; height:18px; border-radius:50%; border:2px solid rgba(255,255,255,0.8); background:transparent;"></div>
      </div>
      <span style="font-size:18px; font-weight:700; color:#111827; letter-spacing:-0.02em;">Horizon Bank</span>
    </div>
    <!-- Nav links -->
    <div style="display:flex; align-items:center; gap:32px;">
      <a href="#benefits" style="font-size:14px; color:#4b5563; text-decoration:none; font-weight:500;">Benefits</a>
      <a href="#rewards" style="font-size:14px; color:#4b5563; text-decoration:none; font-weight:500;">Rewards</a>
      <a href="#security" style="font-size:14px; color:#4b5563; text-decoration:none; font-weight:500;">Security</a>
      <a href="#faq" style="font-size:14px; color:#4b5563; text-decoration:none; font-weight:500;">FAQ</a>
      <a href="#apply" style="font-size:13px; font-weight:600; color:#fff; background:#FF5F00; padding:8px 20px; border-radius:8px; text-decoration:none; transition:opacity 0.2s;">Apply Now</a>
    </div>
  </div>
</nav>

<!-- ─── Hero Section ─── -->
<section style="background:linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); color:#fff; padding:80px 24px; position:relative; overflow:hidden;">
  <!-- Decorative circles -->
  <div style="position:absolute; top:-60px; right:-40px; width:400px; height:400px; border-radius:50%; background:rgba(235,0,27,0.08);"></div>
  <div style="position:absolute; top:40px; right:80px; width:300px; height:300px; border-radius:50%; background:rgba(247,158,27,0.06);"></div>

  <div style="max-width:1120px; margin:0 auto; display:flex; align-items:center; gap:64px; position:relative;">
    <!-- Text -->
    <div style="flex:1;">
      <div style="display:inline-block; font-size:11px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:#F79E1B; background:rgba(247,158,27,0.15); padding:6px 14px; border-radius:20px; margin-bottom:20px;">New Card Launch</div>
      <h1 style="font-size:48px; font-weight:800; line-height:1.1; margin:0 0 20px; letter-spacing:-0.03em;">
        Horizon<br/>Mastercard<span style="color:#FF5F00;">®</span> World
      </h1>
      <p style="font-size:18px; line-height:1.6; color:rgba(255,255,255,0.75); margin:0 0 32px; max-width:480px;">
        Earn unlimited cashback on every purchase. Enjoy premium travel perks, exclusive dining offers, and world-class security — all with no annual fee for the first year.
      </p>
      <div style="display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
        <a href="#apply" style="display:inline-block; font-size:15px; font-weight:600; color:#fff; background:linear-gradient(135deg, #EB001B, #FF5F00); padding:14px 32px; border-radius:10px; text-decoration:none; box-shadow:0 4px 20px rgba(255,95,0,0.3); transition:transform 0.2s;">Apply Now</a>
        <a href="#benefits" style="display:inline-flex; align-items:center; gap:6px; font-size:14px; color:rgba(255,255,255,0.7); text-decoration:none;">
          Learn more
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <!-- Key stats -->
      <div style="display:flex; gap:40px; margin-top:40px; padding-top:32px; border-top:1px solid rgba(255,255,255,0.1);">
        <div>
          <div style="font-size:28px; font-weight:800; color:#FF5F00;">3%</div>
          <div style="font-size:12px; color:rgba(255,255,255,0.5); margin-top:4px;">Dining Cashback</div>
        </div>
        <div>
          <div style="font-size:28px; font-weight:800; color:#F79E1B;">2%</div>
          <div style="font-size:12px; color:rgba(255,255,255,0.5); margin-top:4px;">Online Shopping</div>
        </div>
        <div>
          <div style="font-size:28px; font-weight:800; color:#fff;">1%</div>
          <div style="font-size:12px; color:rgba(255,255,255,0.5); margin-top:4px;">Everything Else</div>
        </div>
      </div>
    </div>
    <!-- Card visual -->
    <div style="flex-shrink:0; position:relative;">
      <div style="width:340px; height:214px; border-radius:16px; background:linear-gradient(135deg, #1a1a2e, #2d2d44); box-shadow:0 20px 60px rgba(0,0,0,0.4); padding:28px; position:relative; overflow:hidden;">
        <!-- Card chip -->
        <div style="width:40px; height:30px; border-radius:6px; background:linear-gradient(135deg, #d4af37, #f0d060); margin-bottom:24px;"></div>
        <!-- Card number -->
        <div style="font-size:18px; font-weight:500; letter-spacing:0.15em; color:rgba(255,255,255,0.8); margin-bottom:20px; font-family:'Courier New', monospace;">•••• •••• •••• 4821</div>
        <!-- Card holder + expiry -->
        <div style="display:flex; justify-content:space-between; align-items:flex-end;">
          <div>
            <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.1em; color:rgba(255,255,255,0.4); margin-bottom:4px;">Card Holder</div>
            <div style="font-size:13px; font-weight:500; color:rgba(255,255,255,0.8); text-transform:uppercase; letter-spacing:0.05em;">YOUR NAME</div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.1em; color:rgba(255,255,255,0.4); margin-bottom:4px;">Expires</div>
            <div style="font-size:13px; font-weight:500; color:rgba(255,255,255,0.8);">12/28</div>
          </div>
        </div>
        <!-- Mastercard circles -->
        <div style="position:absolute; bottom:20px; right:24px; display:flex;">
          <div style="width:32px; height:32px; border-radius:50%; background:#EB001B; opacity:0.9;"></div>
          <div style="width:32px; height:32px; border-radius:50%; background:#F79E1B; opacity:0.9; margin-left:-10px;"></div>
        </div>
        <!-- Contactless icon -->
        <div style="position:absolute; top:28px; right:24px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5">
            <path d="M8.5 16.5a5 5 0 0 1 0-9"/>
            <path d="M12 18a8 8 0 0 0 0-12"/>
            <path d="M15.5 19.5a11 11 0 0 0 0-15"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─── Welcome Bonus Banner ─── -->
<section style="background:linear-gradient(90deg, #FF5F00, #EB001B); color:#fff; padding:20px 24px; text-align:center;">
  <div style="max-width:1120px; margin:0 auto; display:flex; align-items:center; justify-content:center; gap:16px; flex-wrap:wrap;">
    <span style="font-size:15px; font-weight:600;">Limited Time Offer: NT$3,000 welcome bonus on your first purchase</span>
    <a href="#apply" style="font-size:12px; font-weight:600; background:#fff; color:#EB001B; padding:6px 16px; border-radius:6px; text-decoration:none;">Claim Now</a>
  </div>
</section>

<!-- ─── Benefits Section ─── -->
<section id="benefits" style="padding:80px 24px; background:#fff;">
  <div style="max-width:1120px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:56px;">
      <div style="font-size:11px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:#FF5F00; margin-bottom:8px;">Why Choose Horizon</div>
      <h2 style="font-size:36px; font-weight:800; color:#111827; margin:0 0 12px; letter-spacing:-0.02em;">Benefits That Fit Your Lifestyle</h2>
      <p style="font-size:16px; color:#6b7280; max-width:560px; margin:0 auto;">From everyday purchases to international travel, Horizon Mastercard World gives you more at every turn.</p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:32px;">
      <!-- Benefit 1 -->
      <div style="padding:32px; border-radius:16px; border:1px solid #f3f4f6; transition:box-shadow 0.2s;">
        <div style="width:48px; height:48px; border-radius:12px; background:linear-gradient(135deg, #FEF3C7, #FDE68A); display:flex; align-items:center; justify-content:center; margin-bottom:20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <h3 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 8px;">Unlimited Cashback</h3>
        <p style="font-size:14px; color:#6b7280; line-height:1.6; margin:0;">Earn 3% on dining, 2% on online shopping, and 1% on all other purchases — with no cap on rewards.</p>
      </div>

      <!-- Benefit 2 -->
      <div style="padding:32px; border-radius:16px; border:1px solid #f3f4f6;">
        <div style="width:48px; height:48px; border-radius:12px; background:linear-gradient(135deg, #DBEAFE, #93C5FD); display:flex; align-items:center; justify-content:center; margin-bottom:20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </div>
        <h3 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 8px;">Travel Privileges</h3>
        <p style="font-size:14px; color:#6b7280; line-height:1.6; margin:0;">Complimentary airport lounge access at 1,000+ lounges worldwide. Includes travel insurance up to NT$20M.</p>
      </div>

      <!-- Benefit 3 -->
      <div style="padding:32px; border-radius:16px; border:1px solid #f3f4f6;">
        <div style="width:48px; height:48px; border-radius:12px; background:linear-gradient(135deg, #FCE7F3, #F9A8D4); display:flex; align-items:center; justify-content:center; margin-bottom:20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#DB2777" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </div>
        <h3 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 8px;">Exclusive Offers</h3>
        <p style="font-size:14px; color:#6b7280; line-height:1.6; margin:0;">Access exclusive dining and shopping offers at 500+ partner merchants. Up to 20% off at selected restaurants.</p>
      </div>

      <!-- Benefit 4 -->
      <div style="padding:32px; border-radius:16px; border:1px solid #f3f4f6;">
        <div style="width:48px; height:48px; border-radius:12px; background:linear-gradient(135deg, #D1FAE5, #6EE7B7); display:flex; align-items:center; justify-content:center; margin-bottom:20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        </div>
        <h3 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 8px;">No Annual Fee (1st Year)</h3>
        <p style="font-size:14px; color:#6b7280; line-height:1.6; margin:0;">Enjoy all premium benefits with zero annual fee for the first year. Regular annual fee of NT$2,000 thereafter.</p>
      </div>

      <!-- Benefit 5 -->
      <div style="padding:32px; border-radius:16px; border:1px solid #f3f4f6;">
        <div style="width:48px; height:48px; border-radius:12px; background:linear-gradient(135deg, #EDE9FE, #C4B5FD); display:flex; align-items:center; justify-content:center; margin-bottom:20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7C3AED" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 8px;">Purchase Protection</h3>
        <p style="font-size:14px; color:#6b7280; line-height:1.6; margin:0;">90-day purchase protection on eligible items. Extended warranty adds up to 1 additional year of coverage.</p>
      </div>

      <!-- Benefit 6 -->
      <div style="padding:32px; border-radius:16px; border:1px solid #f3f4f6;">
        <div style="width:48px; height:48px; border-radius:12px; background:linear-gradient(135deg, #FEE2E2, #FCA5A5); display:flex; align-items:center; justify-content:center; margin-bottom:20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <h3 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 8px;">Contactless Payment</h3>
        <p style="font-size:14px; color:#6b7280; line-height:1.6; margin:0;">Tap to pay with Mastercard contactless. Works with Apple Pay, Google Pay, and Samsung Pay.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─── Rewards Section ─── -->
<section id="rewards" style="padding:80px 24px; background:#f9fafb;">
  <div style="max-width:1120px; margin:0 auto; display:flex; align-items:center; gap:64px;">
    <!-- Left: Visual -->
    <div style="flex:1;">
      <div style="background:linear-gradient(135deg, #1a1a2e, #0f3460); border-radius:20px; padding:40px; color:#fff;">
        <div style="font-size:13px; font-weight:600; color:#F79E1B; margin-bottom:16px; text-transform:uppercase; letter-spacing:0.06em;">Cashback Rewards</div>
        <div style="display:flex; align-items:flex-end; gap:16px; margin-bottom:32px;">
          <div style="font-size:56px; font-weight:800; line-height:1; color:#FF5F00;">NT$3,000</div>
          <div style="font-size:14px; color:rgba(255,255,255,0.6); padding-bottom:8px;">Welcome Bonus</div>
        </div>
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px;">
          <div style="background:rgba(255,255,255,0.08); border-radius:12px; padding:16px; text-align:center;">
            <div style="font-size:24px; font-weight:800; color:#FF5F00;">3%</div>
            <div style="font-size:11px; color:rgba(255,255,255,0.5); margin-top:4px;">Dining</div>
          </div>
          <div style="background:rgba(255,255,255,0.08); border-radius:12px; padding:16px; text-align:center;">
            <div style="font-size:24px; font-weight:800; color:#F79E1B;">2%</div>
            <div style="font-size:11px; color:rgba(255,255,255,0.5); margin-top:4px;">Online</div>
          </div>
          <div style="background:rgba(255,255,255,0.08); border-radius:12px; padding:16px; text-align:center;">
            <div style="font-size:24px; font-weight:800; color:#fff;">1%</div>
            <div style="font-size:11px; color:rgba(255,255,255,0.5); margin-top:4px;">Others</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Text -->
    <div style="flex:1;">
      <div style="font-size:11px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:#FF5F00; margin-bottom:8px;">Rewards Program</div>
      <h2 style="font-size:32px; font-weight:800; color:#111827; margin:0 0 16px; letter-spacing:-0.02em;">Every Swipe Counts</h2>
      <p style="font-size:15px; color:#6b7280; line-height:1.7; margin:0 0 24px;">
        Your Horizon Mastercard World rewards you on every transaction. Cashback is automatically credited to your statement each month — no points to track, no redemption hassle.
      </p>
      <div style="display:flex; flex-direction:column; gap:16px;">
        <div style="display:flex; align-items:flex-start; gap:12px;">
          <div style="width:24px; height:24px; border-radius:50%; background:#FF5F00; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <div style="font-size:14px; font-weight:600; color:#111827;">Auto-credited monthly</div>
            <div style="font-size:13px; color:#6b7280;">Cashback appears on your next statement automatically</div>
          </div>
        </div>
        <div style="display:flex; align-items:flex-start; gap:12px;">
          <div style="width:24px; height:24px; border-radius:50%; background:#FF5F00; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <div style="font-size:14px; font-weight:600; color:#111827;">No expiry on rewards</div>
            <div style="font-size:13px; color:#6b7280;">Your cashback never expires as long as your account is active</div>
          </div>
        </div>
        <div style="display:flex; align-items:flex-start; gap:12px;">
          <div style="width:24px; height:24px; border-radius:50%; background:#FF5F00; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <div style="font-size:14px; font-weight:600; color:#111827;">No cap on earnings</div>
            <div style="font-size:13px; color:#6b7280;">Earn unlimited cashback with no monthly or annual ceiling</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─── Security Section ─── -->
<section id="security" style="padding:80px 24px; background:#fff;">
  <div style="max-width:1120px; margin:0 auto; text-align:center;">
    <div style="font-size:11px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:#FF5F00; margin-bottom:8px;">Security</div>
    <h2 style="font-size:36px; font-weight:800; color:#111827; margin:0 0 12px; letter-spacing:-0.02em;">Protected at Every Step</h2>
    <p style="font-size:16px; color:#6b7280; max-width:560px; margin:0 auto 48px;">Mastercard's multi-layered security keeps your account safe with industry-leading fraud protection.</p>

    <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:24px;">
      <div style="padding:24px; text-align:center;">
        <div style="width:56px; height:56px; border-radius:50%; background:#f3f4f6; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div style="font-size:14px; font-weight:600; color:#111827; margin-bottom:4px;">Zero Liability</div>
        <div style="font-size:12px; color:#6b7280;">Not responsible for unauthorized transactions</div>
      </div>
      <div style="padding:24px; text-align:center;">
        <div style="width:56px; height:56px; border-radius:50%; background:#f3f4f6; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div style="font-size:14px; font-weight:600; color:#111827; margin-bottom:4px;">3D Secure</div>
        <div style="font-size:12px; color:#6b7280;">Extra authentication for online purchases</div>
      </div>
      <div style="padding:24px; text-align:center;">
        <div style="width:56px; height:56px; border-radius:50%; background:#f3f4f6; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <div style="font-size:14px; font-weight:600; color:#111827; margin-bottom:4px;">Real-time Alerts</div>
        <div style="font-size:12px; color:#6b7280;">Instant notification for every transaction</div>
      </div>
      <div style="padding:24px; text-align:center;">
        <div style="width:56px; height:56px; border-radius:50%; background:#f3f4f6; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M9 12l2 2 4-4"/></svg>
        </div>
        <div style="font-size:14px; font-weight:600; color:#111827; margin-bottom:4px;">ID Theft Protection</div>
        <div style="font-size:12px; color:#6b7280;">Monitoring and resolution support included</div>
      </div>
    </div>
  </div>
</section>

<!-- ─── FAQ Section ─── -->
<section id="faq" style="padding:80px 24px; background:#f9fafb;">
  <div style="max-width:720px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:48px;">
      <div style="font-size:11px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:#FF5F00; margin-bottom:8px;">FAQ</div>
      <h2 style="font-size:32px; font-weight:800; color:#111827; margin:0; letter-spacing:-0.02em;">Frequently Asked Questions</h2>
    </div>

    <div style="display:flex; flex-direction:column; gap:12px;">
      <details style="background:#fff; border-radius:12px; border:1px solid #e5e7eb; overflow:hidden;">
        <summary style="padding:20px 24px; font-size:15px; font-weight:600; color:#111827; cursor:pointer; list-style:none; display:flex; justify-content:space-between; align-items:center;">
          How do I apply for the Horizon Mastercard World?
        </summary>
